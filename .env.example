# Fake values for disposable local development only. Never reuse in production.
# The API reads DATABASE_URL; Phase 3 Compose also consumes POSTGRES_* values.
POSTGRES_DB=tasks
POSTGRES_USER=tasks_app
POSTGRES_PASSWORD=local_example_change_me
# 'db' is the Compose service hostname. Use localhost only when running
# Python on the host against a separately provisioned local PostgreSQL instance.
DATABASE_URL=postgresql+psycopg://tasks_app:local_example_change_me@db:5432/tasks
# JSON application log threshold: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO
